# 이 파일을 pi/.env 로 복사한 뒤 값을 채운다. pi/.env는 GitHub에 올리지 않는다 (.gitignore).
#   cp ~/seed10k/pi/env.example ~/seed10k/pi/.env && chmod 600 ~/seed10k/pi/.env && nano ~/seed10k/pi/.env

SUPABASE_URL=https://ictjkqbbcaigdvlysdaw.supabase.co

# Supabase 대시보드 → Project Settings → API Keys → Secret keys 의 키 (sb_secret_ 로 시작).
# 데이터베이스에 마음대로 쓸 수 있는 키라 절대 공개하지 않는다.
SUPABASE_SERVICE_ROLE_KEY=

# (선택) Edge Function 비밀값에 넣어 둔 것과 같은 값. 비워 두면 한국어 뉴스와 공시는 받지 않는다.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
DART_API_KEY=
